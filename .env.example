# Thư mục lưu dữ liệu job
DATA_DIR=./data
# Model nhận dạng giọng: small | medium | large-v3-turbo | large-v3 (GPU nên dùng large-v3-turbo)
WHISPER_MODEL=medium
# Số job chạy đồng thời (1 là an toàn cho máy 1 GPU)
MAX_WORKERS=1
# Tuỳ chọn: dịch bằng Claude (tự nhiên hơn Google Translate)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Tuỳ chọn: bật thêm 9 giọng Việt bản xứ của FPT.AI (Bắc/Trung/Nam)
FPT_API_KEY=
# Tuỳ chọn: cookie Xiaohongshu (khi link bị chặn / đòi đăng nhập), dạng chuỗi "a=1; b=2"
XHS_COOKIE=
